        if (activeCount > 0) {
          assignedStaff.push({ ...s, count: activeCount });
        } else {
          unassignedStaff.push({ ...s, count: totalCount });
        }

        if (totalCount > 0) {
          totalServicesStaff.push({ ...s, count: totalCount });
        }
      });

