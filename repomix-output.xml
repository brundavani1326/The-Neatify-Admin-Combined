        };

        const { data: existingProf } = await supabase
          .from("staff_profile")
          .select("id")
          .eq("id", userId)
          .maybeSingle();

        let insertError;
        if (existingProf) {
          const { error: updateErr } = await supabase
            .from("staff_profile")
