            <p style={{ color: "#333", fontSize: "14px" }}>{validationAlert}</p>
            <button
              onClick={() => setValidationAlert("")}
              style={{
                marginTop: "20px",
                padding: "8px 25px",
                borderRadius: "6px",
                border: "none",
                cursor: "pointer",
                backgroundColor: "#dc2626",
                color: "#fff",
                fontWeight: "600",
              }}
            >
              OK
            </button>
          </div>
        </div>
      )}
    </div>
  );
}

