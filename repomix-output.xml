      >
        {value}
      </div>
      {secondary ? (
        <div style={{ marginTop: "2px", color: "#475569", fontSize: "13px" }}>
          {secondary}
        </div>
      ) : null}
    </div>
  );
}

export default StaffCancellationAlert;
